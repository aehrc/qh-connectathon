@startuml services-architecture
' Illustrative architecture, reduced to six boxes and no crossing lines. Eventing, conformance and the
' imaging provider are on the service map (services-map.puml) and left out here to keep this readable.
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 17
skinparam componentStyle rectangle
skinparam ArrowColor #001D34
skinparam ArrowFontColor #757579
skinparam ArrowFontSize 14
skinparam component {
  FontColor #001D34
  BorderColor #757579
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #757579
}
left to right direction

component "Referrer app\n(browser / EMR)" as REF #F2F2F2
component "Legacy RIS\nHL7 v2 over MLLP" as RIS #F2F2F2
component "Directory\nHCPD / Qld PD on FHIR" as DIR #E8E9FA;line:1E22AA
component "Referral and\nbooking server" as SRV #E8E9FA;line:1E22AA
component "Legacy adapter\nv2 to FHIR maps" as ADP #FDEBD3;line:D9822B
component "Terminology\nOntoserver" as TX #E6F6FA;line:00A9CE

REF --> DIR : 1 discover
REF --> SRV : 2 refer, 3 book
RIS --> ADP : HL7 v2
ADP --> SRV : FHIR
DIR --> TX
SRV --> TX

REF -[hidden]down-> RIS
DIR -[hidden]down-> SRV
SRV -[hidden]down-> ADP

legend bottom
  |= Level |= What it takes |
  |<#E6F6FA> 1 | Stock server + configuration |
  |<#E8E9FA> 2 | Plus an Implementation Guide (no code) |
  |<#FDEBD3> 3 | Plus bespoke code |
  Illustrative. The two demo stacks (Track 2A and Caret) are separate and share no infrastructure or data.
endlegend
@enduml
