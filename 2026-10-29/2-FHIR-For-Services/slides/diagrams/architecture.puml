@startuml architecture
' Systems and roles for the radiology referral scenario
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam componentStyle rectangle
skinparam component {
  BorderColor #00A9CE
  BackgroundColor #E6F6FA
  FontColor #001D34
}
skinparam actor {
  BorderColor #00A9CE
  BackgroundColor #E6F6FA
}
skinparam ArrowColor #001D34
skinparam ArrowFontColor #757579

actor "Referrer (Placer)\nPatient-Referral app" as R
component "Qld Health\nProvider Directory\non FHIR\nqhpd.hospservices.net" as D
component "ADHA HCPD\ntest environment (SIT)" as H
component "Referral Server\n(HAPI + QH IG)\nqhreferral.hospservices.net" as S
component "Imaging Provider (Filler / RIS)\nPatient-Referral Filler view\nris.hospservices.net" as F
actor "Patient app\n(stretch)" as P
component "Terminology Server\n(open sandbox Ontoserver)\nr4.ontoserver.csiro.au/fhir" as T

H --> D : bulk data extraction\n($export)
R --> D : discover service + Endpoint
R --> S : create referral\n(ServiceRequest + Task)
R --> S : search Slot / book Appointment
F --> S : triage, publish Slots,\nconfirm booking
S --> F : deliver new Tasks
P ..> S : view referral / self-book

D ..> T
S ..> T
F ..> T

note right of T
  External — not deployed.
  Shared by every server and app
  ($expand / $validate-code)
end note

note right of S
  Holds ServiceRequest, Task,
  Schedule / Slot / Appointment
end note

note top of R
  Patient-Referral —
  live at patient-referral.hospservices.net,
  pointed at the
  Qld Health Provider Directory on FHIR
end note

@enduml
