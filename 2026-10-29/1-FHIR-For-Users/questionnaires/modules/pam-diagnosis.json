  "version": "0.1.0",
  "name": "PAMDiagnosis",
  "title": "PAM module — Diagnosis",
  "status": "draft",
  "experimental": true,
  "date": "2026-10-06",
  "publisher": "FHIR in Queensland Health Connectathon — Track 1 (synthetic demo, not for clinical use)",
  "item": [
    {
      "linkId": "pam-diagnosis-section",
      "text": "Diagnosis",
      "type": "group",
      "item": [
        {
          "linkId": "pam-diagnosis-module",
          "text": "Module",
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
              "valueBoolean": true
            }
          ],
          "initial": [
            {
              "valueString": "pam-diagnosis|0.1.0"
            }
          ]
        },
        {
          "linkId": "pam-findings-intro",
          "type": "display",
          "text": "Findings, calculated from the pathology results",
          "_text": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/rendering-xhtml",
                "valueString": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><b>Findings</b>, calculated from the pathology results (thresholds to confirm with Metro North)</p></div>"
              }
            ]
          }
        },
        {
          "linkId": "pam-anaemia",
          "text": "Anaemia (Hb ≤ 130 g/L male, ≤ 120 g/L female)",
          "type": "boolean",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%hb <= %hbThreshold"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-iron-deficiency",
          "text": "Iron deficiency (ferritin < 100, or TSAT < 20% with ferritin 100–300 and CRP > 10)",
          "type": "boolean",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%ferritin < 100 or (%tsat < 20 and %ferritin >= 100 and %ferritin <= 300 and %crp > 10)"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-inflammation",
          "text": "Inflammation (CRP > 10 mg/L)",
          "type": "boolean",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "%crp > 10"
              }
            }
          ],
          "readOnly": true
        },
        {
          "linkId": "pam-diagnosis",
          "text": "Diagnosis",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
              "extension": [
                {
                  "url": "template",
                  "valueReference": {
                    "reference": "#PAMDiagnosisTemplate"
                  }
                }
              ]
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "87522002",
                "display": "Iron deficiency anaemia"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "35240004",
                "display": "Iron deficiency"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "234347009",
                "display": "Anaemia of chronic disease"
              }
            },
            {
              "valueCoding": {
                "system": "http://snomed.info/sct",
                "code": "271737000",
                "display": "Anaemia"
              }
            }
          ]
        },
        {
          "linkId": "pam-diagnosis-todo",
          "type": "display",
          "text": "To be built at the connectathon — scenario A6: the rest of Diagnosis. Suggest the diagnosis from the findings, so the nurse confirms rather than chooses; A SNOMED CT-AU value set on Ontoserver instead of four hard-coded options; Limited consent or refusal of blood products → Flag; requested target Hb → Goal",
          "_text": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/rendering-xhtml",
                "valueString": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><div style=\"border:2px dashed #B9531A;border-radius:8px;padding:12px 16px;background:#FFF6EF\"><p style=\"margin:0 0 6px;font-weight:600;color:#B9531A\">&#x1F6A7; To be built at the connectathon — <a href=\"https://github.com/aehrc/qh-connectathon/blob/main/2026-10-29/1-FHIR-For-Users/Scenarios.md\">scenario A6</a>: the rest of Diagnosis</p><ul style=\"margin:0;padding-left:20px\"><li>Suggest the diagnosis from the findings, so the nurse confirms rather than chooses</li><li>A SNOMED CT-AU value set on Ontoserver instead of four hard-coded options</li><li>Limited consent or refusal of blood products → Flag; requested target Hb → Goal</li></ul></div></div>"
              }
            ]
          }
        }
      ]
    }
  ],
