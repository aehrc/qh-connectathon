{
  "resourceType": "TestScript",
  "id": "scenario1-step6-patient-displays-erequest",
  "url": "https://gitlab.com/australian-e-health-research-centre/fhir-frog/sparked-testing-2026-07-08/TestScript/scenario1-step6-patient-displays-erequest",
  "name": "Scenario1Step6PatientDisplaysERequest",
  "title": "Scenario 1 / Step 6: Patient app displays the eRequest details and fulfilment status",
  "status": "draft",
  "description": "HL7 AU Sparked Testing Event (2026-07-08), Scenario 1 / Step 6: a patient-facing app reads ServiceRequest/s1-sr-1 (completed) and the referenced Patient to display the request details and its fulfilment status to the patient. Read-only against the LOCAL HAPI FHIR server.",
  "fixture": [
    { "id": "patient-fixture", "autocreate": false, "autodelete": false, "resource": { "reference": "Patient-s1-patient-1" } },
    { "id": "org-fixture", "autocreate": false, "autodelete": false, "resource": { "reference": "Organization-s1-org-requester" } },
    { "id": "pr-fixture", "autocreate": false, "autodelete": false, "resource": { "reference": "PractitionerRole-s1-pr-requester" } },
    { "id": "sr-completed-fixture", "autocreate": false, "autodelete": false, "resource": { "reference": "ServiceRequest-s1-sr-completed" } }
  ],
  "setup": {
    "action": [
      { "operation": { "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "update" }, "resource": "Patient", "sourceId": "patient-fixture", "responseId": "setup-patient-response" } },
      { "assert": { "resource": "Patient", "sourceId": "setup-patient-response" } },
      { "operation": { "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "update" }, "resource": "Organization", "sourceId": "org-fixture", "responseId": "setup-org-response" } },
      { "assert": { "resource": "Organization", "sourceId": "setup-org-response" } },
      { "operation": { "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "update" }, "resource": "PractitionerRole", "sourceId": "pr-fixture", "responseId": "setup-pr-response" } },
      { "assert": { "resource": "PractitionerRole", "sourceId": "setup-pr-response" } },
      { "operation": { "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "update" }, "resource": "ServiceRequest", "description": "Ensure ServiceRequest/s1-sr-1 exists in completed state for the patient app to display.", "sourceId": "sr-completed-fixture", "responseId": "setup-sr-response" } },
      { "assert": { "resource": "ServiceRequest", "sourceId": "setup-sr-response" } }
    ]
  },
  "test": [
    {
      "name": "Patient app displays the eRequest and its fulfilment status",
      "description": "GET ServiceRequest/s1-sr-1. Asserts HTTP 200, status=completed, and that the request is for the expected patient.",
      "action": [
        {
          "operation": {
            "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "read" },
            "resource": "ServiceRequest",
            "params": "/s1-sr-1",
            "responseId": "read-sr-response"
          }
        },
        { "assert": { "response": "okay", "sourceId": "read-sr-response" } },
        { "assert": { "expression": "ServiceRequest.status", "value": "completed", "sourceId": "read-sr-response" } },
        { "assert": { "expression": "ServiceRequest.subject.reference", "value": "Patient/s1-patient-1", "sourceId": "read-sr-response" } }
      ]
    },
    {
      "name": "Patient app displays the patient's own details",
      "description": "GET Patient/s1-patient-1. Asserts HTTP 200.",
      "action": [
        {
          "operation": {
            "type": { "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes", "code": "read" },
            "resource": "Patient",
            "params": "/s1-patient-1",
            "responseId": "read-patient-response"
          }
        },
        { "assert": { "response": "okay", "sourceId": "read-patient-response" } },
        { "assert": { "resource": "Patient", "sourceId": "read-patient-response" } }
      ]
    }
  ]
}
