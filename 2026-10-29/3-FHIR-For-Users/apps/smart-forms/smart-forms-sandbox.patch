+// Some FHIR gateways (e.g. Meld) reject a raw '|' in the query string with a 400 that has no CORS
+// headers. Browsers don't encode '|', so encode it here for every request (token|system, url|version).
+const originalFetch = window.fetch.bind(window);
+window.fetch = (input: RequestInfo | URL, init?: RequestInit) => {
+  if (typeof input === 'string' || input instanceof URL) {
+    const url = input.toString();
+    const q = url.indexOf('?');
+    if (q !== -1 && url.indexOf('|', q) !== -1) {
+      input = url.slice(0, q) + url.slice(q).replace(/\|/g, '%7C');
+    }
+  }
+  return originalFetch(input, init);
+};
